# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# PyTorch / Models / Large Weights
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.bin
models/checkpoints/*.joblib
!models/checkpoints/.gitkeep

# Datasets (Keep directory structure but exclude raw medical data)
data/raw/triage/*
!data/raw/triage/.gitkeep
data/raw/xray/*
!data/raw/xray/.gitkeep
data/raw/voice/*
!data/raw/voice/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experiment Outputs (Exclude generated heavy artifacts)
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/plots/*
!outputs/plots/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment secrets & credentials
.env
.env.*
*.key

# Local runtime logs & cache
logs/
.pytest_cache/
